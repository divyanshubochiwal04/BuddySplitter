# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key for trusted backend database operations (bypasses RLS). NEVER expose to users.
SUPABASE_SERVICE_ROLE_KEY=

# Node Environment (development | test | production)
NODE_ENV=development

# Server Port (injected by Render in production, default: 3000)
PORT=3000

# Secret token to authenticate Telegram webhook updates (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# Optional dedicated webhook path (default: /telegram/webhook)
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional public URL to the hosted Privacy Policy
PRIVACY_POLICY_URL=
